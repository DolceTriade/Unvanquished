<rml>
<head>
<link type="text/rcss" href="/ui/shared/basics.rcss" />
<style>
	body {
		width: 100%;
		height: 100%;
	}
	div#mine {
		position: absolute;
		text-align: center;
		width: 10%;
		margin-top: 30%;
		margin-left: auto;
		margin-right: auto;
		color: white;
		background-color: #666666cc;
	}
	div#charge-ring {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 6em;
		height: 6em;
		margin-left: -3em;
		margin-top: -3em;
	}

	progresselement {
		display: block;
		width: 100%;
		height: 100%;
	}

	donutprogress {
		display: block;
		width: 100%;
		height: 100%;
		innerRadius: 1em;
		outerRadius: 1.3em;
		color: #002efd;
	}
	div#rate {
		position: absolute;
		font-size: 1.3em;
		height: 1.5em;
		bottom: 0em;
		left: 0em;
		margin-left: 1em;
	}

	.warning {
		color: yellow;
	}

	.error {
		color: red;
	}
</style>
</head>
<body id="hud_builder">
	<div id="mine">
		<predictedMineEfficiency />
	</div>
	<div id="charge-ring">
		<progresselement src="btimer" targetAttribute="value">
			<donutprogress id="charge-ring-ring" />
		</progresselement>
	</div>
	<div id="rate">
		<mine_rate/>
	</div>
</body>
</rml>
