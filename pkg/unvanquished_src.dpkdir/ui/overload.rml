<rml>
<head>
	<link type="text/rcss" href="/ui/shared/basics.rcss" />
	<link type="text/rcss" href="/ui/shared/infobox.rcss" />
	<script src="lua/util.lua" />
	<style>
		body {
			width: 100%;
			height: 100%;
			background: #01090bcc;
			color: #d9ffff;
		}
		#backdrop {
			width: 100%;
			height: 100%;
			padding: 0.9em;
			box-sizing: border-box;
			background: #031316dd;
		}
		#shell {
			width: 100%;
