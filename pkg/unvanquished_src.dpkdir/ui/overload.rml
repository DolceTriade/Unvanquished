<rml>
<head>
	<link type="text/rcss" href="/ui/shared/basics.rcss" />
	<link type="text/rcss" href="/ui/shared/infobox.rcss" />
	<script src="lua/util.lua" />
	<style>
		body {
			width: 52em;
			height: 36em;
			margin: 6% auto auto auto;
			padding: 1.2em 1.4em;
			background: #041518f2;
			color: #d9ffff;
		}
		tabset {
			height: 100%;
		}
		tabset > panel {
			height: 29.5em;
		}
		tab {
			display: inline-block;
			margin-right: 0.4em;
			padding: 0.35em 0.7em;
			background: #0f2629;
			color: #8abdc2;
		}
		tab:selected {
			background: #184046;
			color: #d9ffff;
		}
		body::scrollbar {
			margin-left: 0.4em;
		}
		h1 {
			margin: 0 0 0.2em 0;
			font-size: 1.5em;
			color: #9efcff;
		}
		p.subtitle {
			margin: 0 0 1em 0;
			color: #8abdc2;
		}
		#rows {
			height: 28.5em;
			overflow-y: auto;
			padding-right: 0.5em;
		}
		.rows {
			height: 27.5em;
			overflow-y: auto;
			padding-right: 0.5em;
		}
		.purchase {
			margin-bottom: 0.7em;
			padding: 0.75em 0.9em;
			background: #0c2428dd;
		}
		.purchase.bp {
			background: #173238dd;
		}
		.purchase.unlock {
			background: #2b2115dd;
		}
		.purchase.upgrade {
			background: #0c2428dd;
		}
		.purchase.owned {
			background: #112216dd;
		}
		.purchase.partial {
			background: #2c2815dd;
		}
		.purchase-header {
			display: block;
			margin-bottom: 0.2em;
		}
		.kind {
			display: inline-block;
			margin-right: 0.6em;
			padding: 0.1em 0.45em;
			background: #27474d;
			color: #d9ffff;
			font-size: 0.78em;
			text-transform: uppercase;
		}
		.kind.unlock {
			background: #5a3f1a;
		}
		.kind.upgrade {
			background: #1d4e56;
		}
		.kind.bp {
			background: #355a23;
		}
		.purchase h2 {
			margin: 0;
			font-size: 1.05em;
			color: #ffffff;
		}
		.purchase p {
			margin: 0.28em 0 0 0;
			color: #9ed2d7;
			white-space: pre-wrap;
		}
		.meta {
			margin-top: 0.5em;
			font-size: 0.92em;
			color: #b8e7eb;
		}
		.actions {
			margin-top: 0.55em;
		}
		.actions button {
			margin-right: 0.45em;
			padding: 0.35em 0.7em;
			background: #12373d;
			color: #dfffff;
		}
		.actions button:hover {
			background: #1a4b53;
		}
		.actions button.owned {
			background: #244128;
			color: #b9efb3;
		}
		.footer {
			margin-top: 0.9em;
			text-align: right;
			color: #8abdc2;
		}
	</style>
	<script>
		function EscapeHtml(text)
			if text == nil then return "" end
			text = string.gsub(text, "&", "&amp;")
			text = string.gsub(text, "<", "&lt;")
			text = string.gsub(text, ">", "&gt;")
			text = string.gsub(text, '"', "&quot;")
			return text
		end

		function FormatDescription(text)
			text = EscapeHtml(text)
			text = string.gsub(text, "&lt;[bB][rR]%s*/&gt;", "<br />")
			text = string.gsub(text, "&lt;[bB][rR]&gt;", "<br />")
			text = string.gsub(text, "\\n", "<br />")
			text = string.gsub(text, "\n", "<br />")
			return text
		end

		function KindClass(kind)
			if kind == "bp" then return "bp" end
			if kind == "unlock" then return "unlock" end
			return "upgrade"
		end

		function KindLabel(kind)
			if kind == "bp" then return "BP" end
			if kind == "unlock" then return "Unlock" end
			return "Upgrade"
		end

		function PurchaseButtons(command, status)
			if status == "owned" then
				return '<button class="owned" onclick="return false;">Owned</button>'
			end

			return string.format(
				'<button onclick="OverloadBuy(\'%s\', 100)">+100</button>' ..
				'<button onclick="OverloadBuy(\'%s\', 500)">+500</button>' ..
				'<button onclick="OverloadBuy(\'%s\', 1000)">+1000</button>',
				command, command, command)
		end

		function OverloadBuy(command, spend)
			Cmd.exec("teambuy " .. command .. " " .. spend)
		end

		function BuildRows(document, targetId, filterKind)
			CDataSource.Build("overloadList", "default")
			local rows = CDataSource.Read("overloadList", "default", "name,description,command,cost,progress,status,kind")
			local html = ""
			for i = 1, #rows do
				local row = rows[i]
				if row[7] == filterKind then
					local typeClass = KindClass(row[7])
					html = html .. string.format(
						'<div class="purchase %s %s">' ..
						'<div class="purchase-header"><span class="kind %s">%s</span><h2>%s</h2></div>' ..
						'<p>%s</p>' ..
						'<div class="meta">Next cost: %s credits</div>' ..
						'<div class="meta">Progress: %s</div>' ..
						'<div class="actions">%s</div>' ..
						'</div>',
						typeClass,
						row[6],
						typeClass,
						KindLabel(row[7]),
						EscapeHtml(row[1]),
						FormatDescription(row[2]),
						EscapeHtml(row[4]),
						EscapeHtml(row[5]),
						PurchaseButtons(row[3], row[6]))
				end
			end
			document:GetElementById(targetId).inner_rml = html
		end

		function BuildOverloadMenu(document)
			BuildRows(document, "bpRows", "bp")
			BuildRows(document, "unlockRows", "unlock")
			BuildRows(document, "upgradeRows", "upgrade")
		end

		function OverloadHandleKey(event, document)
			if event.parameters.key_identifier == rmlui.key_identifier.ESCAPE then
				Events.pushcmd("hide overload")
				event:StopPropagation()
			end
		end
	</script>
</head>
<body id="overload" onshow="CloseOtherCirclemenus(event) BuildOverloadMenu(document)" onrefreshdata="BuildOverloadMenu(document)" onmousedown="RightClickClose(event, document)" onkeydown="OverloadHandleKey(event, document)">
	<h1><translate>Overload</translate></h1>
	<p class="subtitle"><translate>Spend personal credits at the main structure to fund team BP, unlocks, and upgrades.</translate></p>
	<tabset>
		<tab><translate>BP</translate></tab>
		<panel>
			<div class="rows" id="bpRows"></div>
		</panel>
		<tab><translate>Unlocks</translate></tab>
		<panel>
			<div class="rows" id="unlockRows"></div>
		</panel>
		<tab><translate>Upgrades</translate></tab>
		<panel>
			<div class="rows" id="upgradeRows"></div>
		</panel>
	</tabset>
	<div class="footer"><translate>Press ESC or right click to close.</translate></div>
</body>
</rml>
