		donutprogress.group-other {
			color: #93c4ce;
		}
	</style>
	<script>
		OverloadFilter = "available"
		OverloadSearchFilter = ""
		OverloadSelectedThing = ""

		function KindLabel(kind)
			if kind == "bp" then return "BP" end
			if kind == "unlock" then return "Unlock" end
			return "Upgrade"
		end

		function StatusPriority(status)
			if status == "partial" then return 1 end
			if status == "available" then return 2 end
			if status == "expensive" then return 3 end
			if status == "locked" then return 4 end
			if status == "owned" or status == "maxed" then return 5 end
			return 6
		end

		function StatusLabel(status)
			if status == "partial" then return "In Progress" end
			if status == "available" then return "Available" end
			if status == "expensive" then return "Need More Credits" end
			if status == "locked" then return "Locked" end
			if status == "owned" or status == "maxed" then return "Complete" end
			return "Unknown"
		end

		function StatusBadgeClass(status)
			if status == "partial" then return "progress" end
			if status == "owned" or status == "maxed" then return "complete" end
			if status == "locked" then return "locked" end
			if status == "expensive" then return "expensive" end
			return ""
		end

		function ActionLabel(kind, status)
			if kind == "bp" then return "Buy Bundle" end
			if kind == "unlock" then
				if status == "partial" or status == "expensive" then return "Finish Unlock" end
				return "Unlock"
			end
			if status == "partial" then return "Finish Rank" end
			return "Buy Next"
		end

		function FilterMatches(status)
			if OverloadFilter == "all" then return true end
			if OverloadFilter == "available" then return status == "available" or status == "expensive" or status == "partial" end
			if OverloadFilter == "progress" then return status == "partial" end
			if OverloadFilter == "done" then return status == "owned" or status == "maxed" end
			return true
		end

		function SearchMatches(row)
			if OverloadSearchFilter == "" then return true end
			local haystack = string.lower((row.name or "") .. " " .. (row.thingLabel or "") .. " " .. (row.description or ""))
			return string.find(haystack, string.lower(OverloadSearchFilter), 1, true) ~= nil
		end

		function RowVisible(row)
			return FilterMatches(row.status) and SearchMatches(row)
		end

		function SpendButtons(row)
			local status = row.status
			if status == "owned" or status == "maxed" then
				return '<button class="owned" onclick="return false;">Complete</button>'
			end
			if status == "locked" and row.kind ~= "unlock" then
				return string.format(
					'<button class="locked" onclick="return false;">%s</button>',
					ActionLabel(row.kind, status))
			end

			local remaining = tonumber(row.remaining) or 0
			local buttonClass = status == "locked" and row.kind == "unlock" and ' class="locked"' or ""
			local buttons = string.format(
				'<button%s onclick="OverloadBuy(\'%s\', %d)">%s</button>',
				buttonClass, row.command, remaining, ActionLabel(row.kind, status))

			if remaining > 100 then
				buttons = buttons .. string.format(
					'<button%s onclick="OverloadBuy(\'%s\', 100)">%s</button>',
					buttonClass, row.command, row.quickBuySmallLabel)
			end

			if remaining > 500 then
				buttons = buttons .. string.format(
					'<button%s onclick="OverloadBuy(\'%s\', 500)">%s</button>',
					buttonClass, row.command, row.quickBuyLargeLabel)
			end

			return buttons
		end

		function OverloadBuy(command, spend)
			Cmd.exec("teambuy " .. command .. " " .. spend)
		end

		function ReadRows()
			CDataSource.Build("overloadList", "default")
			local raw = CDataSource.Read("overloadList", "default", "index,name,description,command,cost,progress,status,kind,thing,sortIndex,remaining,investedAmount,nextCostAmount,currencyLabel,quickBuySmallLabel,quickBuyLargeLabel,requiredCompletedCount,completedPurchases,remainingCompletedCount,rank,maxRanks,icon,thingLabel,statLabel,group")
			local rows = {}
			for i = 1, #raw do
				rows[#rows + 1] = {
					index = tonumber(raw[i][1]) or i,
					name = raw[i][2],
					description = raw[i][3],
					command = raw[i][4],
					cost = raw[i][5],
					progress = raw[i][6],
					status = raw[i][7],
					kind = raw[i][8],
					thing = raw[i][9],
					sortIndex = tonumber(raw[i][10]) or 999,
					remaining = raw[i][11],
					investedAmount = tonumber(raw[i][12]) or 0,
					nextCostAmount = tonumber(raw[i][13]) or 0,
					currencyLabel = raw[i][14],
					quickBuySmallLabel = raw[i][15],
					quickBuyLargeLabel = raw[i][16],
					requiredCompletedCount = tonumber(raw[i][17]) or 0,
					completedPurchases = tonumber(raw[i][18]) or 0,
					remainingCompletedCount = tonumber(raw[i][19]) or 0,
					rank = tonumber(raw[i][20]) or 0,
					maxRanks = tonumber(raw[i][21]) or 0,
					icon = raw[i][22],
					thingLabel = raw[i][23],
					statLabel = raw[i][24],
					group = raw[i][25] or "Other",
				}
			end
			table.sort(rows, function(a, b)
				if a.index ~= b.index then return a.index < b.index end
				return (a.name or "") < (b.name or "")
			end)
			return rows
		end

		function GroupToken(label)
			local token = string.lower(label or "other")
			token = string.gsub(token, "%s+", "-")
			token = string.gsub(token, "[^%w%-]", "")
			if token == "" then return "group-other" end
			return "group-" .. token
		end

		function GroupOrder(groupLabel)
			if groupLabel == "Build Points" then return 1 end
			if groupLabel == "Weapons" then return 2 end
			if groupLabel == "Equipment" then return 3 end
			if groupLabel == "Lifeforms" then return 4 end
			if groupLabel == "Structures" then return 5 end
			if groupLabel == "Team" then return 6 end
			return 99
		end

		function GenericThingLabel(row)
			local text = row.thing or ""
			text = string.gsub(text, "_", " ")
			text = string.gsub(text, "(%a)([%w_]*)", function(first, rest)
				return string.upper(first) .. string.lower(rest)
			end)
			return text
		end

		function FallbackLabel(row)
			if row.kind == "bp" then return "BP" end
			if row.kind == "unlock" then return "UN" end
			return "UP"
		end

		function TileIconHtml(row)
			if row.icon ~= nil and row.icon ~= "" then
				return string.format('<img src="/%s"/>', row.icon)
			end
			return string.format('<div class="tile-icon-fallback">%s</div>', FallbackLabel(row))
		end

		function DisplayLabel(row)
			if row.thingLabel ~= nil and row.thingLabel ~= "" then
				return row.thingLabel
			end
			local generic = GenericThingLabel(row)
			if generic ~= "" then
				return generic
			end
			return row.name or ""
		end

		function VisibleProgressionGroups(rows)
			local groups = {}
			for i = 1, #rows do
				local row = rows[i]
				local key = row.thing or row.thingLabel or row.name
				local group = groups[key]
				if group == nil then
					group = {
						key = key,
						groupLabel = row.group or "Other",
						groupToken = GroupToken(row.group or "Other"),
						unlock = nil,
						upgrades = {},
						mainRow = row,
						firstIndex = row.index,
						sortIndex = row.sortIndex,
						hasVisibleRows = false,
					}
					groups[key] = group
				end

				if row.index < group.firstIndex then
					group.firstIndex = row.index
				end
				if row.sortIndex < group.sortIndex then
					group.sortIndex = row.sortIndex
				end

				if row.kind == "unlock" then
					group.unlock = row
					group.mainRow = row
				else
					group.upgrades[#group.upgrades + 1] = row
					if group.unlock == nil and #group.upgrades == 1 then
						group.mainRow = row
					end
				end

				if RowVisible(row) then
					group.hasVisibleRows = true
				end
			end

			local order = {}
			for key, _ in pairs(groups) do
				if groups[key].hasVisibleRows then
					order[#order + 1] = key
				end
			end

			table.sort(order, function(a, b)
				local groupA = groups[a]
				local groupB = groups[b]
				local orderA = GroupOrder(groupA.groupLabel)
				local orderB = GroupOrder(groupB.groupLabel)
				if orderA ~= orderB then return orderA < orderB end
				if groupA.sortIndex ~= groupB.sortIndex then return groupA.sortIndex < groupB.sortIndex end
				return groupA.firstIndex < groupB.firstIndex
			end)

			return groups, order
		end

		function EnsureSelectedGroup(groups, order)
			if OverloadSelectedThing ~= "" and groups[OverloadSelectedThing] ~= nil then
				return groups[OverloadSelectedThing]
			end

			if #order > 0 then
				OverloadSelectedThing = order[1]
				return groups[order[1]]
			end

			OverloadSelectedThing = ""
			return nil
		end

		function GroupStatus(group)
			if group.mainRow ~= nil and group.mainRow.kind == "bp" then
				return group.mainRow.status
			end

			if group.unlock ~= nil and #group.upgrades == 0 then
				return group.unlock.status
			end

			local best = group.unlock ~= nil and group.unlock.status or "maxed"
			for i = 1, #group.upgrades do
				local status = group.upgrades[i].status
				if StatusPriority(status) < StatusPriority(best) then
					best = status
				end
			end
			return best
		end

		function GroupStatusText(group)
			if group.mainRow ~= nil and group.mainRow.kind == "bp" then
				return StatusLabel(group.mainRow.status)
			end

			if group.unlock ~= nil and group.unlock.status ~= "owned" and group.unlock.status ~= "maxed" then
				return "Locked"
			end

			if #group.upgrades == 0 then
				return StatusLabel(GroupStatus(group))
			end

			return string.format('%d upgrades, %s', #group.upgrades, StatusLabel(GroupStatus(group)))
		end

		function GroupMetaText(group)
			if group.mainRow ~= nil and group.mainRow.kind == "bp" then
				return string.format('Bundle: %s', group.mainRow.progress or "")
			end

			if group.unlock ~= nil and group.unlock.status ~= "owned" and group.unlock.status ~= "maxed" then
				return string.format('%s to unlock', group.unlock.progress or "")
			end

			if #group.upgrades == 0 then
				if group.unlock ~= nil then
					return "Unlocked"
				end
				return "No upgrades"
			end

			local partialCount = 0
			local availableCount = 0
			local expensiveCount = 0
			local doneCount = 0

			for i = 1, #group.upgrades do
				local status = group.upgrades[i].status
				if status == "partial" then partialCount = partialCount + 1 end
				if status == "available" then availableCount = availableCount + 1 end
				if status == "expensive" then expensiveCount = expensiveCount + 1 end
				if status == "owned" or status == "maxed" then doneCount = doneCount + 1 end
			end

			if partialCount > 0 then
				return string.format('%d in progress, %d complete', partialCount, doneCount)
			end

			if availableCount > 0 then
				return string.format('%d ready, %d complete', availableCount, doneCount)
			end

			if expensiveCount > 0 then
				return string.format('%d waiting for credits', expensiveCount)
			end

			return string.format('%d complete', doneCount)
		end

		function UpgradeLineText(row)
			local nextRank = (tonumber(row.rank) or 0) + 1
			return string.format('%s for %s +%d', row.progress or "", row.statLabel or "upgrade", nextRank)
		end

		function UpgradeDetailTitle(row)
			local nextRank = (tonumber(row.rank) or 0) + 1
			return string.format('%s +%d', row.statLabel or "upgrade", nextRank)
		end

		function RingProgressValue(row)
			if row.status == "owned" or row.status == "maxed" then return 1 end
			if row.nextCostAmount <= 0 then return 0 end
			local value = row.investedAmount / row.nextCostAmount
			if value < 0 then value = 0 end
			if value > 1 then value = 1 end
			return value
		end

		function RingLabel(row)
			if row.kind == "bp" then return "BP" end
			if row.kind == "unlock" then return "Unlock" end

			local label = row.statLabel or "upgrade"
			if label == "damage" then return "Damage" end
			if label == "ammo" then return "Ammo" end
			if label == "fuel" then return "Fuel" end
			if label == "stamina" then return "Stamina" end
			if label == "vitality" then return "Vitality" end
			if label == "heal rate" then return "Heal" end
			if label == "healing rate" then return "Heal" end
			if label == "pounce damage" then return "Pounce" end
			if label == "barb refresh" then return "Refresh" end
			if label == "barb damage" then return "Barb" end
			if label == "trample damage" then return "Trample" end
			if label == "armor integrity" then return "Armour" end
			if label == "max health" then return "Health" end
			return label
		end

		function RenderRing(row, groupToken)
			return string.format(
				'<div class="progress-ring">' ..
				'<donutprogress class="mini-donut %s" value="%.4f" />' ..
				'<div class="progress-ring-label">%s</div>' ..
				'</div>',
				groupToken,
				RingProgressValue(row),
				Rocket_QuakeToRML(RingLabel(row)))
		end

		function GroupRingsHtml(group)
			local html = ""

			if group.mainRow.kind == "bp" then
				return '<div class="progress-rings">' .. RenderRing(group.mainRow, group.groupToken) .. '</div>'
			end

			if group.unlock ~= nil and group.unlock.status ~= "owned" and group.unlock.status ~= "maxed" then
				return '<div class="progress-rings">' .. RenderRing(group.unlock, group.groupToken) .. '</div>'
			end

			if #group.upgrades == 0 then
				return '<div class="progress-line">No upgrades yet.</div>'
			end

			for i = 1, #group.upgrades do
				html = html .. RenderRing(group.upgrades[i], group.groupToken)
			end
			return '<div class="progress-rings">' .. html .. '</div>'
		end

		function GroupBodyHtml(group)
			local body = GroupRingsHtml(group)
			if group.unlock ~= nil and group.unlock.status ~= "owned" and group.unlock.status ~= "maxed" then
				body = body .. string.format('<div class="progress-line">%s</div>', Rocket_QuakeToRML(group.unlock.progress or ""))
				return body
			end

			for i = 1, #group.upgrades do
				body = body .. string.format(
					'<div class="progress-line">%s</div>',
					Rocket_QuakeToRML(UpgradeLineText(group.upgrades[i])))
			end
			return body
		end

		function RenderGroupSection(groups, order, groupLabel)
			local html = ""
			local count = 0
			local token = ""

			for i = 1, #order do
				local group = groups[order[i]]
				if group.groupLabel == groupLabel then
					local main = group.mainRow
					local status = GroupStatus(group)
					token = group.groupToken
					html = html .. string.format(
						'<button class="progress-card %s %s %s" onclick="OverloadSelectThing(\'%s\', document)">' ..
						'<div class="progress-header">' ..
						'<div class="progress-icon">%s</div>' ..
						'<div class="progress-summary"><div class="progress-name">%s</div><div class="progress-status">%s</div><div class="progress-meta">%s</div></div>' ..
						'</div>' ..
						'%s' ..
						'</button>',
						status,
						token,
						group.key == OverloadSelectedThing and "selected" or "",
						group.key,
						TileIconHtml(main),
						Rocket_QuakeToRML(DisplayLabel(main)),
						Rocket_QuakeToRML(GroupStatusText(group)),
						Rocket_QuakeToRML(GroupMetaText(group)),
						GroupBodyHtml(group))
					count = count + 1
				end
			end

			if count == 0 then
				return ""
			end

			return string.format(
				'<div class="group-section">' ..
				'<div class="group-header %s"><span class="group-chip">%s</span><span class="group-count">%d items</span></div>' ..
				'<div class="progress-grid">%s</div>' ..
				'</div>',
				token,
				Rocket_QuakeToRML(groupLabel),
				count,
				html)
		end

		function RenderProgression(groups, order)
			local labels = {}
			local seen = {}
			local html = ""

			for i = 1, #order do
				local label = groups[order[i]].groupLabel
				if not seen[label] then
					seen[label] = true
					labels[#labels + 1] = label
				end
			end

			table.sort(labels, function(a, b)
				local orderA = GroupOrder(a)
				local orderB = GroupOrder(b)
				if orderA ~= orderB then return orderA < orderB end
				return a < b
			end)

			for i = 1, #labels do
				html = html .. RenderGroupSection(groups, order, labels[i])
			end

			if html == "" then
				return '<div class="empty-state">No matching entries.</div>'
			end

			return html
		end

		function RenderUpgradeDetail(row)
			return string.format(
				'<div class="detail-upgrade">' ..
				'<div class="detail-upgrade-title">%s</div>' ..
				'<div class="detail-meta">%s</div>' ..
				'<div class="detail-meta">Next cost: %s %s</div>' ..
				'<div class="detail-meta">%s</div>' ..
				'<div class="detail-actions">%s</div>' ..
				'</div>',
				Rocket_QuakeToRML(UpgradeDetailTitle(row)),
				row.progress or "",
				row.cost,
				row.currencyLabel,
				row.description or "",
				SpendButtons(row))
		end

		function RenderDetail(group)
			if group == nil then
				return '<div class="detail-empty">No matching entries.</div>'
			end

			local row = group.mainRow
			local detailCategory = ""
			if row.thingLabel ~= nil and row.thingLabel ~= "" and row.thingLabel ~= row.name then
				detailCategory = string.format('<div class="detail-category">%s</div>', Rocket_QuakeToRML(row.thingLabel))
			end

			local detailBody = ""
			if row.kind == "bp" then
				detailBody = string.format(
					'<div class="detail-meta">Next cost: %s %s</div>' ..
					'<div class="detail-meta">Progress: %s</div>' ..
					'<div class="detail-actions">%s</div>',
					row.cost,
					row.currencyLabel,
					row.progress,
					SpendButtons(row))
			elseif group.unlock ~= nil and group.unlock.status ~= "owned" and group.unlock.status ~= "maxed" then
				local unlock = group.unlock
				local progression = ""
				if unlock.requiredCompletedCount > 0 then
					progression = string.format(
						'<div class="detail-meta">Team progression: %d / %d completed purchases</div>',
						unlock.completedPurchases,
						unlock.requiredCompletedCount)
				end

				detailBody = string.format(
					'<div class="detail-meta">Next cost: %s %s</div>' ..
					'<div class="detail-meta">%s to unlock</div>' ..
					'%s' ..
					'<div class="detail-actions">%s</div>',
					unlock.cost,
					unlock.currencyLabel,
					unlock.progress,
					progression,
					SpendButtons(unlock))
			else
				local blocks = ""
				for i = 1, #group.upgrades do
					blocks = blocks .. RenderUpgradeDetail(group.upgrades[i])
				end
				if blocks == "" then
					blocks = '<div class="empty-state">No upgrades yet.</div>'
				end
				detailBody = blocks
			end

			return string.format(
				'<div class="detail-layout">' ..
				'<div class="detail-icon">%s</div>' ..
				'<div class="detail-info">' ..
				'<div class="detail-badges"><span class="badge %s">%s</span><span class="badge">%s</span><span class="badge %s">%s</span></div>' ..
				'<div class="detail-name">%s</div>' ..
				'%s' ..
				'<div class="detail-description">%s</div>' ..
				'%s' ..
				'</div>' ..
				'</div>',
				TileIconHtml(row),
				group.groupToken,
				Rocket_QuakeToRML(group.groupLabel),
				row.kind == "bp" and KindLabel(row.kind) or (group.unlock ~= nil and group.unlock.status ~= "owned" and group.unlock.status ~= "maxed" and "Unlock" or "Upgrades"),
				StatusBadgeClass(GroupStatus(group)),
				GroupStatusText(group),
				DisplayLabel(row),
				detailCategory,
				row.description or "",
				detailBody)
		end

		function SetFilterButtonState(document, id, active)
			local element = document:GetElementById(id)
			if element ~= nil then
				element:SetClass("active", active)
			end
		end

		function RefreshFilterButtons(document)
			SetFilterButtonState(document, "filterAll", OverloadFilter == "all")
			SetFilterButtonState(document, "filterAvailable", OverloadFilter == "available")
			SetFilterButtonState(document, "filterProgress", OverloadFilter == "progress")
			SetFilterButtonState(document, "filterDone", OverloadFilter == "done")
		end

		function CurrencyLabel(rows)
			if #rows > 0 and rows[1].currencyLabel ~= nil and rows[1].currencyLabel ~= "" then
				return rows[1].currencyLabel
			end
			return "credits"
		end

		function CurrencyValueHtml(rows)
			local label = CurrencyLabel(rows)
			if label == "morph points" then
				return "<evos/>"
			end
			return "<credits/>"
		end

		function RenderAutoDonatePanel(rows)
			local morphPoints = CurrencyLabel(rows) == "morph points"
			local smallAmount = morphPoints and "1.0" or "100"
			local mediumAmount = morphPoints and "5.0" or "500"
			local maxAmount = morphPoints and "20.0" or "2000"

			return string.format(
				'<div class="autodonate-title"><translate>Auto Donate</translate></div>' ..
				'<div class="autodonate-actions">' ..
				'<button onclick="Cmd.exec(\'autodonate %s\')">%s</button>' ..
				'<button onclick="Cmd.exec(\'autodonate %s\')">%s</button>' ..
				'<button onclick="Cmd.exec(\'autodonate %s\')">%s</button>' ..
				'</div>' ..
				'<div class="autodonate-hint"><translate>Finishes the closest partial purchase first, buys BP when free BP is low and your base is thin, then the cheapest unlock, then a random upgrade.</translate></div>',
				smallAmount,
				morphPoints and "+1.0" or "+100",
				mediumAmount,
				morphPoints and "+5.0" or "+500",
				maxAmount,
				morphPoints and "Cap (20.0)" or "Cap (2000)")
		end

		function BuildOverloadMenu(document)
			local rows = ReadRows()
			local groups, order = VisibleProgressionGroups(rows)
			local selected = EnsureSelectedGroup(groups, order)
			document:GetElementById("detailPanel").inner_rml = RenderDetail(selected)
			document:GetElementById("progressionRows").inner_rml = RenderProgression(groups, order)
			document:GetElementById("currencyValue").inner_rml = CurrencyValueHtml(rows)
			document:GetElementById("currencyLabel").inner_rml = Rocket_QuakeToRML(CurrencyLabel(rows))
			document:GetElementById("autoDonatePanel").inner_rml = RenderAutoDonatePanel(rows)
			RefreshFilterButtons(document)
		end

		function OverloadSelectThing(thing, document)
			OverloadSelectedThing = thing or ""
			BuildOverloadMenu(document)
		end

		function OverloadSetFilter(filter, document)
			OverloadFilter = filter
			BuildOverloadMenu(document)
		end

		function OverloadSetSearchFilter(element, document)
			OverloadSearchFilter = element.attributes["value"] or ""
			BuildOverloadMenu(document)
		end

		function OverloadHandleKey(event, document)
			if event.parameters.key_identifier == rmlui.key_identifier.ESCAPE then
				Events.pushcmd("hide overload")
				event:StopPropagation()
			end
		end
	</script>
</head>
	<body id="overload" onshow="CloseOtherCirclemenus(event) BuildOverloadMenu(document)" onrefreshdata="BuildOverloadMenu(document)" onmousedown="RightClickClose(event, document)" onkeydown="OverloadHandleKey(event, document)">
		<div id="backdrop">
			<div id="shell">
				<div id="workspace">
					<div id="mainColumn">
						<div class="headerbar">
							<h1><translate>Overload</translate></h1>
							<p class="subtitle"><translate>Fund team progression by buying bundles, unlocks, and upgrades at the main structure.</translate></p>
							<p class="hint"><translate>Press ESC or right click to close.</translate></p>
						</div>
						<div class="controls">
							<div class="control-header">
								<div class="currency-panel"><span id="currencyValue"><credits/></span>&nbsp;<span class="currency-label" id="currencyLabel">credits</span></div>
							</div>
							<div class="filter-row">
								<span class="filter-label"><translate>Show</translate></span>
								<button id="filterAvailable" onclick="OverloadSetFilter('available', document)"><translate>Available</translate></button>
								<button id="filterProgress" onclick="OverloadSetFilter('progress', document)"><translate>In Progress</translate></button>
								<button id="filterDone" onclick="OverloadSetFilter('done', document)"><translate>Completed</translate></button>
								<button id="filterAll" onclick="OverloadSetFilter('all', document)"><translate>All</translate></button>
							</div>
							<div class="filter-row">
								<span class="filter-label"><translate>Search</translate></span>
								<input id="searchFilter" type="text" class="text" value="" onkeyup="OverloadSetSearchFilter(event.target_element, document)" placeholder="Filter upgrades, unlocks, or items"/>
							</div>
							<div class="autodonate-panel" id="autoDonatePanel"></div>
						</div>
						<div id="content">
							<div class="section">
								<div class="section-title"><translate>Progression</translate></div>
								<div id="progressionRows"></div>
							</div>
						</div>
					</div>
					<div id="sideColumn">
						<div id="detailPanel"></div>
					</div>
				</div>
			</div>
		</div>
	</body>
</rml>
