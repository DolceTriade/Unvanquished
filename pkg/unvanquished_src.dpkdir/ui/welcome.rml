<rml>
	<head>
		<link type="text/rcss" href="/ui/shared/basics.rcss" />
		<link type="text/template" href="/ui/shared/window.rml" />
		<style>
			body#welcome { position: absolute; top: 0; right: 0; width: 30em; height: 100%; margin: 0; }
			body#welcome window { width: 100%; height: 100%; box-sizing: border-box; }
			#welcomeScores, #welcomeError { max-height: 18em; overflow-y: auto; }
			#welcomeError { color: #ff7777; }
			#welcomeVote { margin-top: 1em; padding-top: 1em; border-top: .1em #666; }
			#welcomeLevelshot { width: 100%; height: 12em; }
			#welcomeLevelshot img { width: 100%; height: 100%; }
			#welcome select { width: 100%; margin-bottom: .5em; }
			#welcome label { display: block; margin-top: .35em; }
		</style>
		<script src="lua/game_menus.lua" />
	</head>
	<body id="welcome" template="window" onshow="GameMenus.LoadWelcome(document)">
		<h1><translate>Welcome</translate></h1>
		<p id="welcomeMap"><translate>Loading match information…</translate></p>
		<div id="welcomeVote">
			<h2><translate>Choose the next game mode</translate></h2>
			<label for="welcomeMode"><translate>Game mode</translate></label>
			<select id="welcomeMode" onchange="GameMenus.ModeChanged(document)">
				<option value="pve"><translate>PVE</translate></option>
				<option value="raid"><translate>Raid</translate></option>
				<option value="towerdefense"><translate>Tower Defense</translate></option>
			</select>
			<div id="welcomeModeSettings">
				<label id="welcomeTeamLabel" for="welcomeTeam"><translate>Team</translate></label>
				<select id="welcomeTeam" onchange="GameMenus.TeamChanged(document)"><option value="human"><translate>Humans</translate></option><option value="alien"><translate>Aliens</translate></option></select>
				<label id="welcomeDifficultyLabel" for="welcomeDifficulty"><translate>Difficulty</translate></label>
				<select id="welcomeDifficulty">
					<option value="easy"><translate>Easy</translate></option>
					<option value="medium" selected><translate>Medium</translate></option>
					<option value="hard"><translate>Hard</translate></option>
				</select>
				<label for="welcomeLayout"><translate>Layout</translate></label>
				<select id="welcomeLayout"></select>
				<button id="welcomeCallVote" onclick="GameMenus.CallModeVote(document)"><translate>Call vote</translate></button>
			</div>
		</div>
		<p id="welcomeError"></p>
		<h2><translate>High scores</translate></h2>
		<div id="welcomeLevelshot"></div>
		<div id="welcomeScores"><translate>Loading scores…</translate></div>
	</body>
</rml>
