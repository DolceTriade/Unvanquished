<rml>
<head>
<link type="text/rcss" href="/ui/shared/basics.rcss" />
<script>
	function UpdateChargeRingColor(document)
		local ring = document:GetElementById("charge-ring-ring")
		if player.team == "alien" then
			ring.style.color = "#ff404080"
		else
			ring.style.color = "#83fff580"
		end
	end
</script>
<style>
	body {
		width: 100%;
		height: 100%;
		z-index: 1;
	}

	div#charge-ring {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 6em;
		height: 6em;
		margin-left: -3em;
		margin-top: -3em;
	}

	progresselement {
		display: block;
		width: 100%;
		height: 100%;
	}

	donutprogress {
		display: block;
		width: 100%;
		height: 100%;
		innerRadius: 1.65em;
		outerRadius: 2em;
		color: #83fff580;
	}
</style>
</head>
<body id="hud_chargebar" onload="UpdateChargeRingColor(document)" onshow="UpdateChargeRingColor(document)">
	<div id="charge-ring">
		<progresselement src="charge" targetAttribute="value">
			<donutprogress id="charge-ring-ring" />
		</progresselement>
	</div>
</body>
</rml>
