<rml>
	<head>
		<link type="text/rcss" href="/ui/shared/basics.rcss" />
		<link type="text/rcss" href="loading.rcss" />
		<style>
			div.levelshot,
			div.levelshot img {
				/* HACK: Pretend to be the background */
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
			}
			div.levelshot {
				z-index: -1;
				background: black;
			}
			div.levelshot img {
				opacity: 0.65;
			}

			barbox {
				display: block;
				position: absolute;
				left: 1em;
				bottom: 2em;
				width: 6em;
				height: 6em;

				background-color: #ffffff00;
			}

			donutprogress {
				display: block;
				width: 100%;
				height: 100%;
				innerRadius: 2em;
				outerRadius: 3em;
				color: green;
			}

			progresselement {
				display: block;
				width: 100%;
				height: 100%;
			}

			progress {
				width: 100%;
				height: 100%;
			}

			progress {
				image-color: #1ab0b5;
			}

			statusbox {
				display: block;

				position: absolute;
				left: 1em;
				bottom: .2em;

				text-align: left;
			}

			percentage {
				display: block;
				position: absolute;
				right: 0em;
				bottom: 0.0em;
				width: 4em;
				height: 4em;
				line-height: 4em;
				text-align: center;
			}

			statusbox,
			percentage {
				color: white;
				font-size: 1.5em;
				font-weight: bold;
				/* Dejavu has monospaced numbers, but Roboto does not
				   This stops the the percentage number "jiggling" left and right */
				font-family: Dejavu Sans;
			}

			infobox {
				display: block;
				position: absolute;
				bottom: 6em;
				width: 100%;
				padding: .7em 1em 1em 1em;
				background-color: #00000080;
				border-color: white;
				border-width: .05em 0em .05em 0em;
				color: white;
				text-align: center;
			}

			changelog {
				display: block;
				position: absolute;
				top: 6em;
				right: 1em;
				width: 30%;
				padding: .7em 1em 1em 1em;
				background-color: #00000080;
				border-color: white;
				border-width: .05em 0em .05em 0em;
				color: white;
			}


			.serverlevelname {
				font-size: 3em;
			}

			.serverlevelauthors {
				font-size: 1.5em;
			}

			.servername {
				font-size: 3em;
			}

			.servermotd {
				font-size: 1.5em;
			}
		</style>
	</head>
	<body id="loading" nohide>
		<div class="levelshot">
		<levelshot_loading/>
		</div>

		<changelog>
			<include src="ui/changelog.rml" />
		</changelog>

		<infobox>
			<div class="serverlevelname"><levelname/></div>
			<div class="serverlevelauthors"><levelauthors/></div>
			<div class="servername"><hostname/></div>
			<div class="servermotd"><motd/></div>
		</infobox>

		<barbox>
			<progresselement src="overall" targetAttribute="value">
				<donutprogress />
			</progresselement>
			<percentage>
				<progress_value src="overall"/>
			</percentage>
		</barbox>

		<statusbox>
			<loadingText/>
		</statusbox>
	</body>
</rml>
