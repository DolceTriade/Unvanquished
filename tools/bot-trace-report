}}

function bindInteractions() {{
  document.body.addEventListener("click", event => {{
    const target = event.target.closest("[data-kind][data-id]");
    if (!target) return;
    state.selectedType = target.dataset.kind;
    state.selectedId = target.dataset.id;
    render();
  }});

  const selectors = [
    ["filter-bot", "bot"],
    ["filter-team", "team"],
    ["filter-behavior", "behavior"],
    ["filter-kind", "kind"],
    ["filter-status", "status"],
    ["filter-state-kind", "stateKind"],
    ["filter-action", "action"],
  ];
  for (const [id, key] of selectors) {{
    document.getElementById(id).addEventListener("change", event => {{
      state.filters[key] = event.target.value;
      resetTableWindow();
      render();
    }});
  }}
  document.getElementById("filter-search").addEventListener("input", event => {{
    state.filters.search = event.target.value.trim().toLowerCase();
    resetTableWindow();
    render();
  }});
  document.getElementById("filter-failures").addEventListener("change", event => {{
    state.filters.failuresOnly = event.target.checked;
    resetTableWindow();
    render();
  }});
  document.getElementById("zoom-in").addEventListener("click", () => {{
    setZoom(state.zoom * ZOOM_STEP);
  }});
  document.getElementById("zoom-out").addEventListener("click", () => {{
    setZoom(state.zoom / ZOOM_STEP);
  }});
  document.getElementById("zoom-reset").addEventListener("click", () => {{
    setZoom(1);
  }});
  document.getElementById("event-viewport").addEventListener("scroll", event => {{
    state.tableScrollTop = event.target.scrollTop;
    renderTable();
  }});
  document.getElementById("timeline").addEventListener("click", event => {{
    const canvas = event.target.closest(".bot-track-canvas");
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    const x = event.clientX - rect.left;
    const y = event.clientY - rect.top;
    const hit = (timelineHitRegions.get(canvas) || []).find(region =>
      x >= region.x && x <= region.x + region.width && y >= region.y && y <= region.y + region.height
    );
    if (!hit) return;
    state.selectedType = hit.type;
    state.selectedId = hit.id;
    render();
  }});
}}

function populateFilters() {{
  fillSelect("filter-bot", REPORT.bots.map(bot => bot.botDisplayName), "All bots");
  fillSelect("filter-team", REPORT.run.teams, "All teams");
