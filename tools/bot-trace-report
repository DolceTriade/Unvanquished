    <div class="filter"><label for="filter-status">Status</label><select id="filter-status"></select></div>
    <div class="filter"><label for="filter-state-kind">State kind</label><select id="filter-state-kind"></select></div>
    <div class="filter"><label for="filter-action">Action / state</label><select id="filter-action"></select></div>
    <div class="filter">
      <label for="filter-search">Search</label>
      <input id="filter-search" type="search" placeholder="bot, action, source, status">
    </div>
    <div class="toggle">
      <input id="filter-failures" type="checkbox">
      <label for="filter-failures">Failures only</label>
    </div>
  </section>

  <section class="main">
    <div class="panel">
      <div class="section-head controls">
        <h2>Timeline</h2>
        <div class="toolbar">
          <button id="zoom-out" type="button">Zoom Out</button>
          <button id="zoom-reset" type="button">Reset</button>
          <button id="zoom-in" type="button">Zoom In</button>
          <div class="zoom-readout" id="zoom-readout">100%</div>
          <div class="subtle" id="timeline-count"></div>
        </div>
      </div>
      <div class="timeline-wrap">
        <div class="timeline-scroll">
          <div id="timeline" class="timeline-grid"></div>
        </div>
      </div>
      <div class="section-head">
        <h2>Raw Events</h2>
        <div class="subtle" id="table-count"></div>
      </div>
      <div class="table-wrap">
        <div class="table-toolbar">
          <div class="subtle" id="table-page-info"></div>
        </div>
        <div class="event-header">
          <div>Time</div>
          <div>Bot</div>
          <div>Team</div>
          <div>Behavior</div>
          <div>Event</div>
          <div>Previous</div>
          <div>Current</div>
          <div>Source</div>
          <div>Line</div>
          <div>Status</div>
        </div>
        <div class="event-viewport" id="event-viewport">
          <div class="event-spacer" id="event-spacer">
            <div class="event-rows" id="event-table"></div>
          </div>
        </div>
      </div>
    </div>

    <aside class="panel alt">
      <div class="section-head">
        <h2>Inspector</h2>
        <div class="subtle" id="selection-type">Nothing selected</div>
      </div>
      <div class="inspector">
        <div class="inspector-card" id="selection-summary">Select a span or event.</div>
        <div class="inspector-card">
          <h3>Details</h3>
          <dl class="kv" id="selection-details"></dl>
        </div>
        <div class="inspector-card">
          <h3>Bot Context</h3>
          <div class="context-list" id="selection-context"></div>
        </div>
      </div>
    </aside>
  </section>
</div>

<script>
const REPORT = __REPORT_PAYLOAD__;

const state = {{
  selectedType: null,
  selectedId: null,
  zoom: 1,
  tableScrollTop: 0,
  filters: {{
    bot: "",
    team: "",
    behavior: "",
    kind: "",
    status: "",
    stateKind: "",
    action: "",
    search: "",
    failuresOnly: false,
  }},
}};

const byEventId = new Map(REPORT.events.map(item => [item.id, item]));
const bySpanId = new Map(REPORT.spans.map(item => [item.id, item]));
const ZOOM_MIN = 0.5;
const ZOOM_MAX = 16;
const ZOOM_STEP = 1.6;
const BOT_LABEL_WIDTH = 220;
const ROW_HEIGHT = 40;
const TABLE_OVERSCAN = 20;
const MIN_SPAN_PX = 7;
const TRACK_HEIGHT = 56;
const ROOT_BAND_TOP = 8;
const ROOT_BAND_HEIGHT = 12;
const ACTION_BAND_TOP = 24;
const ACTION_BAND_HEIGHT = 20;
const TRACK_GRID_COLOR = "rgba(48,39,23,0.08)";
const TRACK_TEXT_COLOR = "#1d1d1b";
const TRACK_SELECTED_STROKE = "rgba(19,93,102,0.9)";
const botEvents = REPORT.events.reduce((acc, event) => {{
  event.botKey = `${{event.botClientNum}}:${{event.botDisplayName}}`;
  event.action = event.current && event.current.action ? event.current.action : (event.current ? event.current.kind : "");
  event.previousAction = event.previous && event.previous.action ? event.previous.action : (event.previous ? event.previous.kind : "");
  event.source = event.current ? (event.current.source || "") : "";
  event.line = event.current ? (event.current.line || 0) : 0;
  event.searchText = [
    event.botDisplayName,
    event.team,
    event.behavior,
    event.backend,
    event.event,
    event.status,
    event.action,
    event.previousAction,
    event.current ? event.current.kind : "",
    event.source,
    event.line,
  ].filter(part => part !== "" && part !== null && part !== undefined).join(" ").toLowerCase();
  (acc[event.botKey] ||= []).push(event);
  return acc;
}}, {{}});
const botSpans = REPORT.spans.reduce((acc, span) => {{
  const key = `${{span.botClientNum}}:${{span.botDisplayName}}`;
  span.botKey = key;
  span.searchText = [
    span.botDisplayName,
    span.team,
    span.behavior,
    span.kind,
    span.action,
    span.source,
    span.line,
  ].filter(part => part !== "" && part !== null && part !== undefined).join(" ").toLowerCase();
  (acc[key] ||= []).push(span);
  return acc;
}}, {{}});
const botBehaviorSpans = REPORT.behaviorSpans.reduce((acc, span) => {{
  (acc[span.botKey] ||= []).push(span);
  return acc;
}}, {{}});
const botFailures = REPORT.events.reduce((acc, event) => {{
  if (event.event === "failure") {{
    (acc[event.botKey] ||= []).push(event);
  }}
  return acc;
}}, {{}});
const timelineHitRegions = new Map();

function uniqueSorted(items) {{
  return Array.from(new Set(items.filter(Boolean))).sort((a, b) => a.localeCompare(b));
}}

function fillSelect(id, values, allLabel) {{
  const select = document.getElementById(id);
  select.innerHTML = "";
  const all = document.createElement("option");
  all.value = "";
  all.textContent = allLabel;
  select.appendChild(all);
  for (const value of values) {{
    const option = document.createElement("option");
    option.value = value;
    option.textContent = value;
    select.appendChild(option);
  }}
}}

function summarizeRun() {{
  const run = REPORT.run;
  document.getElementById("run-lede").textContent =
    `${{run.map}} · ${{run.eventCount}} events · ${{run.botCount}} bots · ` +
    `${{run.firstTime}} to ${{run.lastTime}} ms`;
  const stats = [
    ["Map", run.map],
    ["Time Range", `${{run.firstTime}} to ${{run.lastTime}} ms`],
    ["Behaviors", run.behaviors.join(", ") || "n/a"],
    ["Backends", run.backends.join(", ") || "n/a"],
    ["Teams", run.teams.join(", ") || "n/a"],
    ["Events", String(run.eventCount)],
  ];
  document.getElementById("stats").innerHTML = stats.map(([label, value]) => `
    <div class="stat"><div class="stat-label">${{escapeHtml(label)}}</div><div class="stat-value">${{escapeHtml(value)}}</div></div>
  `).join("");
}}

function escapeHtml(value) {{
  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");
}}

function colorForSpan(span) {{
  if (span.kind === "root_success") return "linear-gradient(135deg,#5f8f6b,#9cc8ac)";
  if (span.kind === "root_failure") return "linear-gradient(135deg,#9c3535,#d98d7f)";
  const palette = [
    ["#1d6f78", "#7cc8bf"],
    ["#9f5f14", "#efc57a"],
    ["#6e3d8b", "#d4a7e4"],
    ["#2c5f2d", "#8ec78f"],
    ["#a0402b", "#e7a576"],
    ["#355c9c", "#88abd9"],
  ];
  const text = `${{span.action}}|${{span.source}}|${{span.behavior}}`;
  let hash = 0;
  for (const ch of text) hash = ((hash * 31) + ch.charCodeAt(0)) >>> 0;
  const pair = palette[hash % palette.length];
  return `linear-gradient(135deg,${{pair[0]}},${{pair[1]}})`;
}}

function matchesFiltersForEvent(event) {{
  const currentKind = event.current ? event.current.kind : "";
  const currentAction = event.current && event.current.action ? event.current.action : currentKind;
  if (state.filters.bot && event.botDisplayName !== state.filters.bot) return false;
  if (state.filters.team && event.team !== state.filters.team) return false;
  if (state.filters.behavior && event.behavior !== state.filters.behavior) return false;
  if (state.filters.kind && event.event !== state.filters.kind) return false;
  if (state.filters.status && event.status !== state.filters.status) return false;
  if (state.filters.stateKind && currentKind !== state.filters.stateKind) return false;
  if (state.filters.action && currentAction !== state.filters.action) return false;
  if (state.filters.failuresOnly && event.event !== "failure") return false;
  if (state.filters.search && !event.searchText.includes(state.filters.search)) return false;
  return true;
}}

function matchesFiltersForSpan(span) {{
  if (state.filters.bot && span.botDisplayName !== state.filters.bot) return false;
  if (state.filters.team && span.team !== state.filters.team) return false;
  if (state.filters.behavior && span.behavior !== state.filters.behavior) return false;
  if (state.filters.kind && state.filters.kind !== "transition") return false;
  if (state.filters.status && span.status !== state.filters.status) return false;
  if (state.filters.stateKind && span.kind !== state.filters.stateKind) return false;
  const action = span.action || span.kind;
  if (state.filters.action && action !== state.filters.action) return false;
  if (state.filters.failuresOnly && span.failureCountWithinSpan < 1) return false;
  if (state.filters.search && !span.searchText.includes(state.filters.search)) return false;
  return true;
}}

function filteredEvents() {{
  return REPORT.events.filter(matchesFiltersForEvent);
}}

function filteredSpans() {{
  return REPORT.spans.filter(matchesFiltersForSpan);
}}

function matchesFiltersForBehaviorSpan(span) {{
  if (state.filters.bot && span.botDisplayName !== state.filters.bot) return false;
  if (state.filters.team && span.team !== state.filters.team) return false;
  if (state.filters.behavior && span.behavior !== state.filters.behavior) return false;
  if (state.filters.status) return false;
  if (state.filters.stateKind && state.filters.stateKind !== "behavior") return false;
  if (state.filters.failuresOnly) return false;
  if (state.filters.search) {{
    const blob = `${{span.botDisplayName}} ${{span.team}} ${{span.behavior}}`.toLowerCase();
    if (!blob.includes(state.filters.search)) return false;
  }}
  return true;
}}

function timelineWidthPx() {{
  return Math.max(980, Math.round(980 * state.zoom));
}}

function setZoom(nextZoom) {{
  state.zoom = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, nextZoom));
  render();
}}

function resetTableWindow() {{
  state.tableScrollTop = 0;
  const viewport = document.getElementById("event-viewport");
  if (viewport) viewport.scrollTop = 0;
}}

function spanFillColor(span) {{
  if (span.kind === "root_success") return "#79ab85";
  if (span.kind === "root_failure") return "#bf665d";
  const palette = [
    "#2d7a83",
    "#bd7a27",
    "#81519c",
    "#3e7f3f",
    "#b65941",
    "#4871b0",
  ];
  const text = `${{span.action}}|${{span.source}}|${{span.behavior}}`;
  let hash = 0;
  for (const ch of text) hash = ((hash * 31) + ch.charCodeAt(0)) >>> 0;
  return palette[hash % palette.length];
}}

function computeTrackLayout(actionSpans, behaviorSpans, failures, start, duration, width) {{
  const items = [];
  for (const span of behaviorSpans) {{
    const x = ((span.startTime - start) / duration) * width;
    const x2 = ((Math.max(span.endTime, span.startTime + 1) - start) / duration) * width;
    const drawWidth = Math.max(MIN_SPAN_PX, x2 - x);
    items.push({{
      type: "behavior",
      id: span.id,
      behaviorSpan: span,
      x,
      width: drawWidth,
      y: ROOT_BAND_TOP,
      height: ROOT_BAND_HEIGHT,
    }});
  }}
  for (const span of actionSpans) {{
    const x = ((span.startTime - start) / duration) * width;
    const x2 = ((Math.max(span.endTime, span.startTime + 1) - start) / duration) * width;
    const drawWidth = Math.max(MIN_SPAN_PX, x2 - x);
    items.push({{
      type: "span",
      id: span.id,
      span,
      x,
      width: drawWidth,
      y: ACTION_BAND_TOP,
      height: ACTION_BAND_HEIGHT,
    }});
  }}
  for (const event of failures) {{
    const x = ((event.time - start) / duration) * width;
    items.push({{
      type: "event",
      id: event.id,
      event,
      x,
      y: 2,
      radius: 4,
    }});
  }}
  return {{
    items,
    height: TRACK_HEIGHT,
  }};
}}

function roundRect(ctx, x, y, width, height, radius) {{
  const r = Math.min(radius, width / 2, height / 2);
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.arcTo(x + width, y, x + width, y + height, r);
  ctx.arcTo(x + width, y + height, x, y + height, r);
  ctx.arcTo(x, y + height, x, y, r);
  ctx.arcTo(x, y, x + width, y, r);
  ctx.closePath();
}}

function drawTrackCanvas(canvas, layout, width) {{
  const ratio = window.devicePixelRatio || 1;
  const height = layout.height;
  canvas.width = Math.max(1, Math.round(width * ratio));
  canvas.height = Math.max(1, Math.round(height * ratio));
  canvas.style.height = `${{height}}px`;
  const ctx = canvas.getContext("2d");
  ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
  ctx.clearRect(0, 0, width, height);

  for (let i = 1; i < 8; i += 1) {{
    const x = (width * i) / 8;
    ctx.strokeStyle = TRACK_GRID_COLOR;
    ctx.beginPath();
    ctx.moveTo(x + 0.5, 0);
    ctx.lineTo(x + 0.5, height);
    ctx.stroke();
  }}

  const hitRegions = [];
  for (const item of layout.items) {{
    if (item.type === "behavior") {{
      const span = item.behaviorSpan;
      roundRect(ctx, item.x, item.y, item.width, item.height, 5);
      ctx.fillStyle = "#d9c9a4";
      ctx.fill();
      ctx.lineWidth = 1;
      ctx.strokeStyle = "rgba(76,57,20,0.25)";
      ctx.stroke();
      if (item.width >= 56) {{
        ctx.save();
        ctx.beginPath();
        ctx.rect(item.x + 4, item.y, Math.max(0, item.width - 8), item.height);
        ctx.clip();
        ctx.fillStyle = TRACK_TEXT_COLOR;
        ctx.font = "11px SFMono-Regular, Consolas, Liberation Mono, monospace";
        ctx.textBaseline = "middle";
        ctx.fillText(span.behavior, item.x + 6, item.y + item.height / 2);
        ctx.restore();
      }}
    }} else if (item.type === "span") {{
      const span = item.span;
      roundRect(ctx, item.x, item.y, item.width, item.height, 6);
      ctx.fillStyle = spanFillColor(span);
      ctx.fill();
      ctx.lineWidth = state.selectedType === "span" && state.selectedId === span.id ? 2.5 : 1;
      ctx.strokeStyle = state.selectedType === "span" && state.selectedId === span.id ? TRACK_SELECTED_STROKE : "rgba(0,0,0,0.18)";
      ctx.stroke();
      if (span.openEnded) {{
        ctx.save();
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(item.x + item.width - 0.5, item.y + 2);
        ctx.lineTo(item.x + item.width - 0.5, item.y + item.height - 2);
        ctx.strokeStyle = "rgba(255,255,255,0.95)";
        ctx.stroke();
        ctx.restore();
      }}
      if (item.width >= 46) {{
        const label = span.action || span.kind;
        if (item.height >= 16) {{
        ctx.save();
        ctx.beginPath();
        ctx.rect(item.x + 6, item.y, Math.max(0, item.width - 12), item.height);
        ctx.clip();
        ctx.fillStyle = TRACK_TEXT_COLOR;
        ctx.font = "12px Iowan Old Style, Palatino Linotype, Book Antiqua, serif";
        ctx.textBaseline = "middle";
        ctx.fillText(label, item.x + 8, item.y + item.height / 2);
        ctx.restore();
        }}
      }}
      hitRegions.push({{
        type: "span",
        id: span.id,
        x: item.x,
        y: item.y,
        width: item.width,
        height: item.height,
      }});
    }} else {{
      const event = item.event;
      ctx.beginPath();
      ctx.arc(item.x, item.y + 5, item.radius, 0, Math.PI * 2);
      ctx.fillStyle = "#7e0f12";
      ctx.fill();
      ctx.lineWidth = state.selectedType === "event" && state.selectedId === event.id ? 2 : 1;
      ctx.strokeStyle = "#fff9f2";
      ctx.stroke();
      hitRegions.push({{
        type: "event",
        id: event.id,
        x: item.x - item.radius - 3,
        y: 0,
        width: item.radius * 2 + 6,
        height: 12,
      }});
    }}
  }}
  timelineHitRegions.set(canvas, hitRegions);
}}

function renderTimeline() {{
  const timeline = document.getElementById("timeline");
  const bots = [];
  const start = REPORT.run.firstTime;
  const end = Math.max(REPORT.run.lastTime, start + 1);
  const duration = end - start;
  const tickCount = 8;
  const trackWidth = timelineWidthPx();
  timeline.style.width = `${{BOT_LABEL_WIDTH + trackWidth}}px`;
  const rowLayouts = [];

  for (const bot of REPORT.bots) {{
    const rowSpans = (botSpans[bot.botKey] || []).filter(matchesFiltersForSpan);
    const rowBehaviorSpans = (botBehaviorSpans[bot.botKey] || []).filter(matchesFiltersForBehaviorSpan);
    const rowFailures = (botFailures[bot.botKey] || []).filter(matchesFiltersForEvent);
    if (!rowSpans.length && !rowBehaviorSpans.length && !rowFailures.length) continue;
    const layout = computeTrackLayout(rowSpans, rowBehaviorSpans, rowFailures, start, duration, trackWidth);
    bots.push(bot);
    rowLayouts.push({{ bot, rowSpans, rowBehaviorSpans, rowFailures, layout }});
  }}

  const axisTicks = Array.from({{length: tickCount + 1}}, (_, idx) => {{
    const ratio = idx / tickCount;
    const left = ratio * 100;
    const value = Math.round(start + duration * ratio);
    return `<div class="axis-tick" style="left:${{left}}%"><span>${{value}}</span></div>`;
  }}).join("");

  const rows = rowLayouts.map((row, index) => {{
    return `
      <div class="bot-row">
        <div class="bot-meta">
          <strong>${{escapeHtml(row.bot.botDisplayName)}}</strong>
          <span>${{escapeHtml(row.bot.team)}} · backend ${{escapeHtml(row.bot.backend)}}</span>
          <span>#${{row.bot.botClientNum}} · ${{row.bot.failureCount}} failures</span>
        </div>
        <div class="bot-track">
          <div class="track-caption behavior">behavior</div>
          <div class="track-caption action">action</div>
          <canvas class="bot-track-canvas" data-row-index="${{index}}"></canvas>
        </div>
      </div>`;
  }}).join("");

  timeline.innerHTML = `
    <div class="timeline-axis">
      <div class="axis-label mono">bot / behavior</div>
      <div class="axis-track">${{axisTicks}}</div>
    </div>
    ${{rows || '<div class="bot-row"><div class="bot-meta"><strong>No matching bots</strong></div><div class="bot-track"></div></div>'}}
  `;
  document.getElementById("timeline-count").textContent =
    `${{rowLayouts.reduce((sum, row) => sum + row.rowSpans.length, 0)}} spans across ${{bots.length}} bots`;
  document.getElementById("zoom-readout").textContent = `${{Math.round(state.zoom * 100)}}%`;
  document.getElementById("zoom-out").disabled = state.zoom <= ZOOM_MIN + 1e-9;
  document.getElementById("zoom-in").disabled = state.zoom >= ZOOM_MAX - 1e-9;

  timeline.querySelectorAll(".bot-track-canvas").forEach((canvas) => {{
    const row = rowLayouts[Number(canvas.dataset.rowIndex)];
    drawTrackCanvas(canvas, row.layout, trackWidth);
  }});
}}

function renderTable() {{
  const rows = filteredEvents();
  const table = document.getElementById("event-table");
  const viewport = document.getElementById("event-viewport");
  const spacer = document.getElementById("event-spacer");
  const viewportHeight = viewport.clientHeight || 540;
  const totalHeight = rows.length * ROW_HEIGHT;
  const startIndex = Math.max(0, Math.floor(state.tableScrollTop / ROW_HEIGHT) - TABLE_OVERSCAN);
  const endIndex = Math.min(rows.length, Math.ceil((state.tableScrollTop + viewportHeight) / ROW_HEIGHT) + TABLE_OVERSCAN);
  const visibleRows = rows.slice(startIndex, endIndex);
  spacer.style.height = `${{totalHeight}}px`;
  table.innerHTML = visibleRows.map((event, offset) => {{
    const prev = event.previous ? (event.previous.action || event.previous.kind) : "∅";
    const curr = event.current ? (event.current.action || event.current.kind) : "∅";
    const classes = ["event-row"];
    if (state.selectedType === "event" && state.selectedId === event.id) classes.push("selected");
    const top = (startIndex + offset) * ROW_HEIGHT;
    return `<div class="${{classes.join(" ")}}" data-kind="event" data-id="${{event.id}}" style="top:${{top}}px">
      <div class="mono">${{event.time}}</div>
      <div>${{escapeHtml(event.botDisplayName)}}</div>
      <div>${{escapeHtml(event.team)}}</div>
      <div>${{escapeHtml(event.behavior)}}</div>
      <div><span class="pill">${{escapeHtml(event.event)}}</span></div>
      <div>${{escapeHtml(prev)}}</div>
      <div>${{escapeHtml(curr)}}</div>
      <div class="mono">${{escapeHtml(event.source || "")}}</div>
      <div class="mono">${{event.line || ""}}</div>
      <div>${{escapeHtml(event.status)}}</div>
    </div>`;
  }}).join("");
  document.getElementById("table-count").textContent = `${{rows.length}} matching events`;
  document.getElementById("table-page-info").textContent =
    rows.length ? `Rows ${{startIndex + 1}}-${{endIndex}} of ${{rows.length}}` : "No matching rows";
}}

function contextForBot(botKey, centerIndex) {{
  const events = botEvents[botKey] || [];
  const idx = Math.max(0, events.findIndex(event => event.index === centerIndex));
  const start = Math.max(0, idx - 2);
  return events.slice(start, Math.min(events.length, idx + 3));
}}

function renderInspector() {{
  const summary = document.getElementById("selection-summary");
  const details = document.getElementById("selection-details");
  const context = document.getElementById("selection-context");
  const selectionType = document.getElementById("selection-type");

  if (!state.selectedType || !state.selectedId) {{
    selectionType.textContent = "Nothing selected";
    summary.textContent = "Select a span or event.";
    details.innerHTML = "";
    context.innerHTML = "";
    return;
  }}

  if (state.selectedType === "span") {{
    const span = bySpanId.get(state.selectedId);
    if (!span) return;
    selectionType.textContent = "Span";
    summary.innerHTML = `<strong>${{escapeHtml(span.botDisplayName)}}</strong> · ${{escapeHtml(span.action || span.kind)}}`;
    const entries = [
      ["Team", span.team],
      ["Behavior", span.behavior],
      ["Backend", span.backend],
      ["Kind", span.kind],
      ["Action", span.action || "n/a"],
      ["Source", span.source || "n/a"],
      ["Line", span.line || "n/a"],
      ["Start", `${{span.startTime}} ms`],
      ["End", `${{span.endTime}} ms`],
      ["Duration", `${{span.duration}} ms`],
      ["Failures", String(span.failureCountWithinSpan)],
      ["Open Ended", span.openEnded ? "yes" : "no"],
    ];
    details.innerHTML = entries.map(([k, v]) => `<dt>${{escapeHtml(k)}}</dt><dd>${{escapeHtml(v)}}</dd>`).join("");
    const sourceEvent = byEventId.get(span.startEventId);
