  summary.innerHTML = `<strong>${{escapeHtml(event.botDisplayName)}}</strong> · ${{escapeHtml(event.event)}} at ${{event.time}} ms`;
  const prev = event.previous ? (event.previous.action || event.previous.kind) : "n/a";
