ROOT_KINDS = {"root_success", "root_failure"}
ANSI_COLOR_RE = re.compile(r"\^(?:\d|x[0-9A-Fa-f]{6})")


def parse_args():
    parser = argparse.ArgumentParser(
        description="Render a self-contained HTML report for a bot transition trace JSONL file."
    )
    parser.add_argument("trace_file", help="Path to one bot trace JSONL file.")
    parser.add_argument(
        "-o",
        "--output",
        help="Output HTML path. Defaults to <trace-file>.html",
    )
    parser.add_argument(
        "--export-events",
        help="Optional JSON output path for normalized events.",
    )
    parser.add_argument(
        "--export-spans",
        help="Optional JSON output path for reconstructed spans.",
    )
    return parser.parse_args()


def clean_bot_name(name):
    cleaned = ANSI_COLOR_RE.sub("", name or "").strip()
    return cleaned or (name or "")


def stable_json(value):
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def event_action(event, field):
    descriptor = event.get(field) or {}
    return descriptor.get("action") or descriptor.get("kind") or ""


def normalize_event(raw, line_number):
    required = {
        "time",
        "map",
        "botClientNum",
        "botName",
        "team",
        "backend",
        "behavior",
        "event",
        "current",
        "status",
    }
    missing = sorted(required - set(raw))
    if missing:
        raise ValueError(f"line {line_number}: missing required fields: {', '.join(missing)}")

    if raw["event"] not in {"transition", "failure"}:
        raise ValueError(f"line {line_number}: unsupported event kind {raw['event']!r}")

    current = raw["current"]
    previous = raw.get("previous")
    if not isinstance(current, dict):
        raise ValueError(f"line {line_number}: current descriptor must be an object")
    if previous is not None and not isinstance(previous, dict):
        raise ValueError(f"line {line_number}: previous descriptor must be null or an object")

    display_name = clean_bot_name(str(raw["botName"]))
    event = {
        "id": f"e{line_number:06d}",
        "lineNumber": line_number,
        "time": int(raw["time"]),
        "map": str(raw["map"]),
        "botClientNum": int(raw["botClientNum"]),
        "botName": str(raw["botName"]),
        "botDisplayName": display_name,
        "team": str(raw["team"]),
        "backend": str(raw["backend"]),
        "behavior": str(raw["behavior"]),
        "event": str(raw["event"]),
        "status": str(raw["status"]),
        "previous": normalize_descriptor(previous),
        "current": normalize_descriptor(current),
        "botKey": f"{int(raw['botClientNum'])}:{display_name}",
        "action": event_action(raw, "current"),
        "previousAction": event_action(raw, "previous"),
        "source": (current.get("source") or "") if isinstance(current, dict) else "",
        "line": int(current.get("line") or 0) if isinstance(current, dict) else 0,
    }
    event["searchText"] = " ".join(
        str(part).lower()
        for part in [
            event["botDisplayName"],
            event["team"],
            event["behavior"],
            event["backend"],
            event["event"],
            event["status"],
            event["action"],
            event["previousAction"],
            event["current"]["kind"],
            event["source"],
            event["line"],
        ]
        if part not in ("", None)
    )
    return event


def normalize_descriptor(descriptor):
    if descriptor is None:
        return None
    kind = str(descriptor.get("kind") or "")
    return {
        "kind": kind,
        "action": str(descriptor.get("action") or ""),
        "source": str(descriptor.get("source") or ""),
        "line": int(descriptor.get("line") or 0),
    }


def load_events(path):
    events = []
    with path.open("r", encoding="utf-8") as handle:
        for line_number, raw_line in enumerate(handle, start=1):
            line = raw_line.strip()
            if not line:
                continue
            try:
                raw = json.loads(line)
            except json.JSONDecodeError as exc:
                raise ValueError(f"line {line_number}: invalid JSON: {exc.msg}") from exc
            events.append(normalize_event(raw, line_number))

    if not events:
        raise ValueError(f"no events found in {path}")

    events.sort(key=lambda event: (event["time"], event["lineNumber"]))
    for index, event in enumerate(events):
        event["index"] = index
    return events


def derive_run_metadata(events):
    maps = Counter(event["map"] for event in events)
    if len(maps) > 1:
        raise ValueError(f"trace contains multiple maps: {', '.join(sorted(maps))}")

    bot_keys = sorted({event["botKey"] for event in events})
    behaviors = sorted({event["behavior"] for event in events if event["behavior"]})
    backends = sorted({event["backend"] for event in events if event["backend"]})
    teams = sorted({event["team"] for event in events if event["team"]})
    return {
        "map": events[0]["map"],
        "firstTime": events[0]["time"],
        "lastTime": events[-1]["time"],
        "eventCount": len(events),
        "botCount": len(bot_keys),
        "behaviors": behaviors,
        "backends": backends,
        "teams": teams,
    }


def finalize_span(span, end_time, open_ended):
    span["endTime"] = end_time
    span["duration"] = max(0, end_time - span["startTime"])
    span["openEnded"] = open_ended
    return span


def reconstruct_spans(events):
    events_by_bot = defaultdict(list)
    for event in events:
        events_by_bot[event["botKey"]].append(event)

    spans = []
    spans_by_id = {}
    for bot_key, bot_events in sorted(events_by_bot.items()):
        current_span = None
        bot_last_time = bot_events[-1]["time"]
        span_counter = 0

        for event in bot_events:
            descriptor = event["current"]
            if event["event"] == "transition":
                if current_span is not None:
                    finalize_span(current_span, event["time"], False)
                    spans.append(current_span)
                    spans_by_id[current_span["id"]] = current_span

                span_counter += 1
                current_span = {
                    "id": f"s{event['botClientNum']:03d}-{span_counter:04d}",
                    "startEventId": event["id"],
                    "endEventId": None,
                    "botClientNum": event["botClientNum"],
                    "botName": event["botName"],
                    "botDisplayName": event["botDisplayName"],
                    "team": event["team"],
                    "backend": event["backend"],
                    "behavior": event["behavior"],
                    "kind": descriptor["kind"],
                    "action": descriptor["action"],
                    "source": descriptor["source"],
                    "line": descriptor["line"],
                    "startTime": event["time"],
                    "endTime": event["time"],
                    "duration": 0,
                    "openEnded": False,
                    "failureCountWithinSpan": 0,
                    "failureEventIds": [],
                    "status": event["status"],
                }
            elif current_span is not None:
                current_span["failureCountWithinSpan"] += 1
                current_span["failureEventIds"].append(event["id"])

            event["spanId"] = current_span["id"] if current_span is not None else None

        if current_span is not None:
            finalize_span(current_span, bot_last_time, True)
            spans.append(current_span)
            spans_by_id[current_span["id"]] = current_span

    for span in spans:
        if span["failureEventIds"]:
            span["endEventId"] = span["failureEventIds"][-1]
        else:
            span["endEventId"] = span["startEventId"]

    return spans


def bot_summaries(events, spans):
    summary_by_key = {}
    for event in events:
        info = summary_by_key.setdefault(
            event["botKey"],
            {
                "botKey": event["botKey"],
                "botClientNum": event["botClientNum"],
                "botName": event["botName"],
                "botDisplayName": event["botDisplayName"],
                "team": event["team"],
                "backend": event["backend"],
                "eventCount": 0,
                "failureCount": 0,
                "firstTime": event["time"],
                "lastTime": event["time"],
            },
        )
        info["eventCount"] += 1
        info["failureCount"] += 1 if event["event"] == "failure" else 0
        info["firstTime"] = min(info["firstTime"], event["time"])
        info["lastTime"] = max(info["lastTime"], event["time"])

    span_counts = Counter(span["botClientNum"] for span in spans)
    for info in summary_by_key.values():
        info["spanCount"] = span_counts.get(info["botClientNum"], 0)

    return sorted(
        summary_by_key.values(),
        key=lambda item: (item["team"], item["botDisplayName"].lower(), item["botClientNum"]),
    )


def build_report_data(events, spans):
    metadata = derive_run_metadata(events)
    report_events = []
    for event in events:
        report_events.append({
            "id": event["id"],
            "index": event["index"],
            "time": event["time"],
            "map": event["map"],
            "botClientNum": event["botClientNum"],
            "botDisplayName": event["botDisplayName"],
            "team": event["team"],
            "backend": event["backend"],
            "behavior": event["behavior"],
            "event": event["event"],
            "status": event["status"],
            "previous": event["previous"],
            "current": event["current"],
            "spanId": event.get("spanId"),
        })

    report_spans = []
    for span in spans:
        report_spans.append({
            "id": span["id"],
            "startEventId": span["startEventId"],
            "endEventId": span["endEventId"],
            "botClientNum": span["botClientNum"],
            "botDisplayName": span["botDisplayName"],
            "team": span["team"],
            "backend": span["backend"],
            "behavior": span["behavior"],
            "kind": span["kind"],
            "action": span["action"],
            "source": span["source"],
            "line": span["line"],
            "startTime": span["startTime"],
            "endTime": span["endTime"],
            "duration": span["duration"],
            "openEnded": span["openEnded"],
            "failureCountWithinSpan": span["failureCountWithinSpan"],
        })

    behavior_spans = []
    events_by_bot = defaultdict(list)
    for event in events:
        events_by_bot[event["botKey"]].append(event)

    for bot_key, bot_events in sorted(events_by_bot.items()):
        current = None
        counter = 0
        last_time = bot_events[-1]["time"]
        for event in bot_events:
            if current is None:
                counter += 1
                current = {
                    "id": f"b{event['botClientNum']:03d}-{counter:04d}",
                    "botKey": bot_key,
                    "botClientNum": event["botClientNum"],
                    "botDisplayName": event["botDisplayName"],
                    "team": event["team"],
                    "backend": event["backend"],
                    "behavior": event["behavior"],
                    "startTime": event["time"],
                    "endTime": event["time"],
                    "openEnded": False,
                }
                continue

            if event["behavior"] != current["behavior"]:
                current["endTime"] = event["time"]
                current["openEnded"] = False
                behavior_spans.append(current)
                counter += 1
                current = {
                    "id": f"b{event['botClientNum']:03d}-{counter:04d}",
                    "botKey": bot_key,
                    "botClientNum": event["botClientNum"],
                    "botDisplayName": event["botDisplayName"],
                    "team": event["team"],
                    "backend": event["backend"],
                    "behavior": event["behavior"],
                    "startTime": event["time"],
                    "endTime": event["time"],
                    "openEnded": False,
                }

        if current is not None:
            current["endTime"] = last_time
            current["openEnded"] = True
            behavior_spans.append(current)

    return {
        "run": metadata,
        "bots": bot_summaries(events, spans),
        "events": report_events,
        "spans": report_spans,
        "behaviorSpans": behavior_spans,
    }


def default_output_path(trace_path):
    return trace_path.with_suffix(trace_path.suffix + ".html") if trace_path.suffix else Path(str(trace_path) + ".html")


def write_json(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


