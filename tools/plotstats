        <div class="summary-stat"><span>Aliens net</span><strong>{summary["final"]["aliens_net"]}</strong></div>
        <div class="summary-stat"><span>Humans net</span><strong>{summary["final"]["humans_net"]}</strong></div>
        <div class="summary-stat"><span>Aliens spent</span><strong>{summary["final"]["aliens_spent"]}</strong></div>
        <div class="summary-stat"><span>Humans spent</span><strong>{summary["final"]["humans_spent"]}</strong></div>
      </section>
      <section class="summary-card">
        <h2>Events By Kind</h2>
        <ul class="summary-list">{summary_kinds}</ul>
      </section>
    </div>
    <div class="legend">
      <strong>Event legend:</strong>
      {"".join(legend_items) if legend_items else '<span class="legend-item">No event kinds in this match</span>'}
    </div>
    <div class="controls">
      <label><input type="checkbox" data-target="series-aliens_net" checked> Aliens net</label>
      <label><input type="checkbox" data-target="series-humans_net" checked> Humans net</label>
      <label><input type="checkbox" data-target="series-aliens_spent" checked> Aliens spent</label>
      <label><input type="checkbox" data-target="series-humans_spent" checked> Humans spent</label>
      <label><input type="checkbox" data-target="alien-events" checked> Alien purchase markers</label>
      <label><input type="checkbox" data-target="human-events" checked> Human purchase markers</label>
      {"".join(toggle_items)}
    </div>
    <div class="chart-shell" id="chart-shell">
      {svg_markup}
      <div class="tooltip" id="tooltip"></div>
    </div>
    <div class="footer">
      Hover the plot area for sampled values. Hover purchase markers for event details.
    </div>
  </main>
  <script>
    const chartData = {json.dumps(chart_data, separators=(",", ":"))};
    const shell = document.getElementById("chart-shell");
    const svg = document.getElementById("chart");
    const hoverTarget = document.getElementById("hover-target");
    const hoverLine = document.getElementById("hover-line");
    const tooltip = document.getElementById("tooltip");

    function updateVisibility(target, visible) {{
      for (const node of document.getElementsByClassName(target)) {{
        node.style.display = visible ? "" : "none";
      }}
    }}

    for (const toggle of document.querySelectorAll("input[data-target]")) {{
      toggle.addEventListener("change", (event) => {{
        updateVisibility(event.target.dataset.target, event.target.checked);
      }});
    }}

    function localPoint(evt) {{
      const pt = svg.createSVGPoint();
      pt.x = evt.clientX;
      pt.y = evt.clientY;
      return pt.matrixTransform(svg.getScreenCTM().inverse());
    }}

    function nearestSample(time) {{
      const samples = chartData.samples;
      let best = samples[0];
      let bestDistance = Math.abs(samples[0].t - time);
      for (const sample of samples) {{
        const distance = Math.abs(sample.t - time);
        if (distance < bestDistance) {{
          best = sample;
          bestDistance = distance;
        }}
      }}
      return best;
    }}

    function showTooltip(clientX, clientY, text) {{
      const shellRect = shell.getBoundingClientRect();
      tooltip.textContent = text;
      let left = clientX - shellRect.left + 14;
      let top = clientY - shellRect.top + 14;

      const maxLeft = Math.max(8, shellRect.width - tooltip.offsetWidth - 8);
      const maxTop = Math.max(8, shellRect.height - tooltip.offsetHeight - 8);
      left = Math.min(Math.max(8, left), maxLeft);
      top = Math.min(Math.max(8, top), maxTop);

      tooltip.style.left = `${{left}}px`;
      tooltip.style.top = `${{top}}px`;
      tooltip.style.visibility = "visible";
    }}

    hoverTarget.addEventListener("mousemove", (evt) => {{
      const p = localPoint(evt);
      const layout = chartData.layout;
      const x = Math.min(Math.max(p.x, layout.marginLeft), layout.marginLeft + layout.plotWidth);
      const ratio = (x - layout.marginLeft) / layout.plotWidth;
      const time = layout.xMin + ratio * (layout.xMax - layout.xMin);
      const sample = nearestSample(time);
      const sampleRatio = (sample.t - layout.xMin) / (layout.xMax - layout.xMin);
      const lineX = layout.marginLeft + sampleRatio * layout.plotWidth;

      hoverLine.setAttribute("x1", lineX);
      hoverLine.setAttribute("x2", lineX);
      hoverLine.setAttribute("visibility", "visible");

      showTooltip(
        evt.clientX,
        evt.clientY,
        `t=${{sample.t}}s\\nAliens net: ${{sample.aliens_net}}\\nHumans net: ${{sample.humans_net}}\\nAliens spent: ${{sample.aliens_spent}}\\nHumans spent: ${{sample.humans_spent}}`
      );
    }});

    hoverTarget.addEventListener("mouseleave", () => {{
      hoverLine.setAttribute("visibility", "hidden");
      tooltip.style.visibility = "hidden";
    }});

    for (const point of document.querySelectorAll(".event-point")) {{
      point.addEventListener("mousemove", (evt) => {{
        showTooltip(evt.clientX, evt.clientY, point.dataset.tooltip);
      }});
      point.addEventListener("mouseleave", () => {{
        tooltip.style.visibility = "hidden";
      }});
    }}
  </script>
</body>
</html>
"""


def main():
    args = parse_args()
    repo_root = Path(__file__).resolve().parent.parent

    stats_file = Path(args.stats_file) if args.stats_file else find_default_stats_file(repo_root)
    stats_file = stats_file.resolve()
    if not stats_file.is_file():
        raise FileNotFoundError(f"stats file not found: {stats_file}")

    output_file = Path(args.output).resolve() if args.output else stats_file.with_suffix(".html")

    samples, events, match_id = parse_stats_file(stats_file)
    html_text = build_html(stats_file, output_file, samples, events, match_id)
    output_file.write_text(html_text, encoding="utf-8")

    print(output_file)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        sys.exit(1)
