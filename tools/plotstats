#! /usr/bin/env python3

import argparse
import html
import json
import sys
from collections import Counter
from pathlib import Path


WIDTH = 1280
HEIGHT = 760
MARGIN_LEFT = 72
MARGIN_RIGHT = 24
MARGIN_TOP = 36
MARGIN_BOTTOM = 56
PLOT_WIDTH = WIDTH - MARGIN_LEFT - MARGIN_RIGHT
PLOT_HEIGHT = HEIGHT - MARGIN_TOP - MARGIN_BOTTOM
EVENT_KIND_STYLES = {
    "buy_weapon": {"label": "Buy weapon", "shape": "circle"},
    "buy_upgrade": {"label": "Buy upgrade", "shape": "square"},
    "evolve": {"label": "Evolve", "shape": "triangle"},
    "teambuy_bp": {"label": "Team buy BP", "shape": "diamond"},
    "teambuy_unlock": {"label": "Team unlock", "shape": "triangle-down"},
    "teambuy_upgrade": {"label": "Team upgrade", "shape": "hex"},
}


def parse_args():
    parser = argparse.ArgumentParser(
        description="Render a self-contained interactive HTML graph for a Format 3 gameplay stats log."
    )
    parser.add_argument("stats_file", nargs="?", help="Path to a gameplay stats log.")
    parser.add_argument(
        "-o", "--output",
        help="Output HTML path. Defaults to <stats-file>.html"
    )
    return parser.parse_args()


def find_default_stats_file(repo_root: Path) -> Path:
    stats_dir = repo_root / "stats" / "gameplay"
    if not stats_dir.is_dir():
        raise FileNotFoundError(f"stats directory not found: {stats_dir}")
    files = sorted(stats_dir.glob("*.log"))
    if not files:
        raise FileNotFoundError(f"no gameplay logs found in {stats_dir}")
    return files[-1]


def parse_stats_file(path: Path):
    samples = []
    raw_events = []
    match_id = ""

    with path.open("r", encoding="utf-8") as handle:
        for raw_line in handle:
            line = raw_line.strip()
            if not line:
                continue

            if line.startswith("# MatchId:"):
                match_id = line.split(":", 1)[1].strip()
                continue

            if line.startswith("#"):
                continue

            if line.startswith("EVT "):
                _, t, team, client, kind, rest = line.split(maxsplit=5)
                item, cost = rest.rsplit(" ", 1)
                raw_events.append({
                    "t": int(t),
                    "team": team,
                    "client": int(client),
                    "kind": kind,
                    "item": item,
                    "cost": int(cost),
                })
                continue

            parts = line.split()
            if len(parts) != 7:
                raise ValueError(f"unexpected sample row: {line}")

            t, aliens_players, humans_players, aliens_net, humans_net, aliens_spent, humans_spent = map(int, parts)
            samples.append({
                "t": t,
                "aliens_players": aliens_players,
                "humans_players": humans_players,
                "aliens_net": aliens_net,
                "humans_net": humans_net,
                "aliens_spent": aliens_spent,
                "humans_spent": humans_spent,
            })

    if not samples:
        raise ValueError(f"no sample rows found in {path}")

    cumulative = {"aliens": 0, "humans": 0}
    events = []
    for event in raw_events:
        if event["team"] in cumulative:
            cumulative[event["team"]] += event["cost"]
            event = dict(event)
            event["cumulative_spent"] = cumulative[event["team"]]
            events.append(event)

    return samples, events, match_id


def summarize_match(samples, events):
    last = samples[-1]
    kind_counts = Counter(event["kind"] for event in events)
    team_counts = Counter(event["team"] for event in events)
    return {
        "duration": last["t"],
        "final": {
            "aliens_net": last["aliens_net"],
            "humans_net": last["humans_net"],
            "aliens_spent": last["aliens_spent"],
            "humans_spent": last["humans_spent"],
            "aliens_players": last["aliens_players"],
            "humans_players": last["humans_players"],
        },
        "events_total": len(events),
        "events_by_kind": dict(sorted(kind_counts.items())),
        "events_by_team": dict(sorted(team_counts.items())),
    }


def axis_ticks(lower, upper, count=6):
    if upper <= lower:
        return [lower]
    return [lower + (upper - lower) * i / count for i in range(count + 1)]


def build_svg(samples, events):
    times = [sample["t"] for sample in samples]
    values = []
    for sample in samples:
        values.extend([
            sample["aliens_net"],
            sample["humans_net"],
            sample["aliens_spent"],
            sample["humans_spent"],
        ])

    if events:
        values.extend(event["cumulative_spent"] for event in events)

    x_min = min(times)
    x_max = max(times)
    if x_max == x_min:
        x_max = x_min + 1

    y_min = min(values)
    y_max = max(values)
    if y_max == y_min:
        y_max = y_min + 1

    y_pad = max(10, (y_max - y_min) * 0.08)
    y_min -= y_pad
    y_max += y_pad

    def x_px(t):
        return MARGIN_LEFT + (t - x_min) / (x_max - x_min) * PLOT_WIDTH

    def y_px(v):
        return MARGIN_TOP + (y_max - v) / (y_max - y_min) * PLOT_HEIGHT

    def path_for(key):
        return " ".join(
            f"{'M' if i == 0 else 'L'} {x_px(sample['t']):.2f} {y_px(sample[key]):.2f}"
            for i, sample in enumerate(samples)
        )

    def event_symbol(shape, px, py, size):
        if shape == "square":
            return f'<rect x="{px - size:.2f}" y="{py - size:.2f}" width="{2 * size:.2f}" height="{2 * size:.2f}"'
        if shape == "triangle":
            pts = [
                (px, py - size * 1.15),
                (px - size, py + size * 0.9),
                (px + size, py + size * 0.9),
            ]
            point_text = " ".join(f"{x:.2f},{y:.2f}" for x, y in pts)
            return f'<polygon points="{point_text}"'
        if shape == "triangle-down":
            pts = [
                (px - size, py - size * 0.9),
                (px + size, py - size * 0.9),
                (px, py + size * 1.15),
            ]
            point_text = " ".join(f"{x:.2f},{y:.2f}" for x, y in pts)
            return f'<polygon points="{point_text}"'
        if shape == "diamond":
            pts = [
                (px, py - size * 1.2),
                (px - size, py),
                (px, py + size * 1.2),
                (px + size, py),
            ]
            point_text = " ".join(f"{x:.2f},{y:.2f}" for x, y in pts)
            return f'<polygon points="{point_text}"'
        if shape == "hex":
            pts = [
                (px - size * 0.9, py - size * 0.55),
                (px, py - size * 1.05),
                (px + size * 0.9, py - size * 0.55),
                (px + size * 0.9, py + size * 0.55),
                (px, py + size * 1.05),
                (px - size * 0.9, py + size * 0.55),
            ]
            point_text = " ".join(f"{x:.2f},{y:.2f}" for x, y in pts)
            return f'<polygon points="{point_text}"'
        return f'<circle cx="{px:.2f}" cy="{py:.2f}" r="{size:.2f}"'

    x_ticks = axis_ticks(x_min, x_max)
    y_ticks = axis_ticks(y_min, y_max)

    parts = []
    parts.append(
        f'<svg id="chart" viewBox="0 0 {WIDTH} {HEIGHT}" xmlns="http://www.w3.org/2000/svg" '
        f'role="img" aria-label="Gameplay economy graph">'
    )
    parts.append(
        f'<rect x="0" y="0" width="{WIDTH}" height="{HEIGHT}" fill="#fffdf8" />'
    )

    for tick in x_ticks:
        px = x_px(tick)
        parts.append(
            f'<line x1="{px:.2f}" y1="{MARGIN_TOP}" x2="{px:.2f}" y2="{MARGIN_TOP + PLOT_HEIGHT}" '
            f'class="grid" />'
        )
        parts.append(
            f'<text x="{px:.2f}" y="{HEIGHT - 18}" class="tick" text-anchor="middle">{int(round(tick))}</text>'
        )

    for tick in y_ticks:
        py = y_px(tick)
        parts.append(
            f'<line x1="{MARGIN_LEFT}" y1="{py:.2f}" x2="{MARGIN_LEFT + PLOT_WIDTH}" y2="{py:.2f}" '
            f'class="grid" />'
        )
        parts.append(
            f'<text x="{MARGIN_LEFT - 10}" y="{py + 4:.2f}" class="tick" text-anchor="end">{int(round(tick))}</text>'
        )

    parts.append(
        f'<line x1="{MARGIN_LEFT}" y1="{MARGIN_TOP}" x2="{MARGIN_LEFT}" y2="{MARGIN_TOP + PLOT_HEIGHT}" class="axis" />'
    )
    parts.append(
        f'<line x1="{MARGIN_LEFT}" y1="{MARGIN_TOP + PLOT_HEIGHT}" x2="{MARGIN_LEFT + PLOT_WIDTH}" y2="{MARGIN_TOP + PLOT_HEIGHT}" class="axis" />'
    )
    parts.append(
        f'<text x="{MARGIN_LEFT + PLOT_WIDTH / 2:.2f}" y="{HEIGHT - 8}" class="axis-label" text-anchor="middle">Match time (s)</text>'
    )
    parts.append(
        f'<text x="20" y="{MARGIN_TOP + PLOT_HEIGHT / 2:.2f}" class="axis-label" text-anchor="middle" '
        f'transform="rotate(-90 20 {MARGIN_TOP + PLOT_HEIGHT / 2:.2f})">Credits</text>'
    )

    series = [
        ("aliens_net", "#2e8b57", "", "Aliens net"),
        ("humans_net", "#1f77b4", "", "Humans net"),
        ("aliens_spent", "#2e8b57", "8 6", "Aliens spent"),
        ("humans_spent", "#1f77b4", "8 6", "Humans spent"),
    ]

    for key, color, dash, label in series:
        dash_attr = f' stroke-dasharray="{dash}"' if dash else ""
        parts.append(
            f'<path d="{path_for(key)}" class="series series-{key}" fill="none" '
            f'stroke="{color}" stroke-width="2.5"{dash_attr} data-label="{html.escape(label)}" />'
        )

    parts.append(
        f'<rect id="hover-target" x="{MARGIN_LEFT}" y="{MARGIN_TOP}" width="{PLOT_WIDTH}" height="{PLOT_HEIGHT}" fill="transparent" />'
    )
    parts.append(
        f'<line id="hover-line" x1="{MARGIN_LEFT}" y1="{MARGIN_TOP}" x2="{MARGIN_LEFT}" y2="{MARGIN_TOP + PLOT_HEIGHT}" visibility="hidden" class="hover-line" />'
    )

    for event in events:
        px = x_px(event["t"])
        py = y_px(event["cumulative_spent"])
        color = "#2e8b57" if event["team"] == "aliens" else "#1f77b4"
        kind_style = EVENT_KIND_STYLES.get(event["kind"], {"label": event["kind"], "shape": "circle"})
        tooltip = (
            f"Team: {event['team']}\n"
            f"Time: {event['t']}s\n"
            f"Event: {kind_style['label']}\n"
            f"Item: {event['item']}\n"
            f"Cost: {event['cost']}\n"
            f"Client: {event['client']}"
        )
        event_class = "alien-events" if event["team"] == "aliens" else "human-events"
        kind_class = f"kind-{event['kind']}"
        symbol = event_symbol(kind_style["shape"], px, py, 5)
        parts.append(
            f'{symbol} class="event-point {event_class} {kind_class}" '
            f'fill="{color}" stroke="#fffdf8" stroke-width="1.2" '
            f'data-tooltip="{html.escape(tooltip)}"><title>{html.escape(tooltip)}</title></{"rect" if kind_style["shape"] == "square" else "polygon" if kind_style["shape"] in {"triangle", "triangle-down", "diamond", "hex"} else "circle"}>'
        )
    parts.append("</svg>")

    chart_data = {
        "samples": samples,
        "layout": {
            "width": WIDTH,
            "height": HEIGHT,
            "marginLeft": MARGIN_LEFT,
            "marginTop": MARGIN_TOP,
            "plotWidth": PLOT_WIDTH,
            "plotHeight": PLOT_HEIGHT,
            "xMin": x_min,
            "xMax": x_max,
        }
    }

    return "\n".join(parts), chart_data


def build_html(stats_file: Path, output_file: Path, samples, events, match_id):
    svg_markup, chart_data = build_svg(samples, events)
    summary = summarize_match(samples, events)
    title = stats_file.name
    if match_id:
        title = f"{title} ({match_id})"

    legend_items = []
    toggle_items = []
    for kind in sorted({event["kind"] for event in events}):
        style = EVENT_KIND_STYLES.get(kind, {"label": kind, "shape": "circle"})
        legend_items.append(
            f'<span class="legend-item"><span class="legend-shape shape-{style["shape"]}"></span>{html.escape(style["label"])}</span>'
        )
        toggle_items.append(
            f'<label><input type="checkbox" data-target="kind-{html.escape(kind)}" checked> {html.escape(style["label"])}</label>'
        )

    summary_kinds = "".join(
        f'<li><span>{html.escape(EVENT_KIND_STYLES.get(kind, {"label": kind})["label"])}</span><strong>{count}</strong></li>'
        for kind, count in summary["events_by_kind"].items()
    ) or '<li><span>No events</span><strong>0</strong></li>'

    return f"""<!doctype html>
