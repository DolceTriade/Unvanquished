      color: var(--ink);
      background:
        radial-gradient(circle at top left, #fff7ea, transparent 30%),
        linear-gradient(180deg, #efe8dc 0%, #f7f2ea 100%);
    }}
    main {{
      max-width: 1360px;
      margin: 0 auto;
      padding: 24px;
    }}
    h1 {{
      margin: 0 0 10px 0;
      font-size: 28px;
    }}
    .meta {{
      color: var(--muted);
      margin-bottom: 18px;
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }}
    .controls {{
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 16px;
      padding: 12px 14px;
      background: rgba(255, 253, 248, 0.88);
      border: 1px solid #dfd8cb;
